# Copy to .env and set values: cp .env.example .env
# Compose file: env-setup-docker-compose.yml — run from repo root:
#   docker compose --env-file docker/.env -f docker/env-setup-docker-compose.yml up -d

# --- MySQL ---
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=win123club

# Host paths (relative to this docker/ folder unless absolute)
MONGO_DATA_DIR=./data/mongo
REPLSET_KEY_PATH=./replset88.key

# --- Hazelcast ---
HAZELCAST_GROUP_NAME=dev
HAZELCAST_GROUP_PASSWORD=changeme

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=demo
RABBITMQ_DEFAULT_PASS=changeme

# --- Redis (Bitnami) ---
REDIS_PASSWORD=changeme
REDIS_ALLOW_EMPTY_PASSWORD=yes
REDIS_DATA_DIR=./data/redis
