{
  "dependencies": {
    "moment": "^2.30.1",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@types/jest": "^29.5.11",
    "crypto-js": "^4.2.0",
    "@types/crypto-js": "^4.2.2"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/assets"],
    "testMatch": ["**/__tests__/**/*.test.ts"],
    "moduleNameMapper": {
      "^cc$": "<rootDir>/assets/__mocks__/cc.ts"
    },
    "setupFiles": ["<rootDir>/assets/__mocks__/cocos-globals.ts"],
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "module": "commonjs",
          "lib": ["dom", "es6", "es2015.promise"],
          "target": "es6",
          "experimentalDecorators": true,
          "skipLibCheck": true
        }
      }
    }
  }
}
